PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_platform
REDIS_URL=redis://localhost:6379

# Chon 1 trong 2
LLM_PROVIDER=anthropic
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

RAG_TOP_K=5
RAG_TOKEN_BUDGET=6000

APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# S3 / MinIO storage for media uploads.
# Defaults below match docker-compose's MinIO service. For prod, swap to AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blog-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public URL prefix for stored objects. Browsers fetch images from here.
S3_PUBLIC_URL=http://localhost:9000/blog-media

ALLOW_REGISTRATION=true
