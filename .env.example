PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_platform
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# S3 / MinIO storage for media uploads.
# Defaults below match docker-compose's MinIO service. For prod, swap to AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blog-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public URL prefix for stored objects. Browsers fetch images from here.
S3_PUBLIC_URL=http://localhost:9000/blog-media
# Optional CDN (e.g. CloudFront) in front of the bucket. When set, newly
# uploaded images are served via this URL instead of the raw S3 endpoint.
# CDN_PUBLIC_URL=https://cdn.strix-blog.uk

ALLOW_REGISTRATION=true

# Set to "true" only when the server is behind a reverse proxy (nginx, Cloudflare, etc.)
# that strips and overwrites X-Forwarded-For / X-Real-IP before they reach this app.
# When false (default), the actual TCP socket IP is used for rate limiting instead,
# making it impossible for clients to spoof their IP.
TRUST_PROXY=false

# Transactional email (Resend).
# EMAIL_ENABLED is the kill switch. When false, OTP flows still run their logic
# but the email body is skipped — useful for local dev and as a global panic
# disable in prod without redeploying. In dev with this off, the API responds
# with a `devCode` field so you can see the code without an inbox.
EMAIL_ENABLED=false
# Get from https://resend.com/api-keys after verifying mail.strix-blog.uk
RESEND_API_KEY=
# Signing secret for the webhook at /webhooks/resend (starts with whsec_)
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Strix Blog <noreply@mail.strix-blog.uk>"
EMAIL_REPLY_TO=support@strix-blog.uk
# Public URL of the SPA, used to build email links (defaults to APP_URL if unset)
FRONTEND_URL=http://localhost:5173

# Google OAuth (Phase 2 - "Sign in with Google").
# Get Client ID + Secret from https://console.cloud.google.com → APIs & Services → Credentials.
# Redirect URI in Google Console MUST match GOOGLE_REDIRECT_URI exactly.
# Leave blank to disable Google sign-in (the /google routes return 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
INDEXNOW_KEY=
