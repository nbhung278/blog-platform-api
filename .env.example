PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_platform
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# S3 / MinIO storage for media uploads.
# Defaults below match docker-compose's MinIO service. For prod, swap to AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blog-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public URL prefix for stored objects. Browsers fetch images from here.
S3_PUBLIC_URL=http://localhost:9000/blog-media
# Optional CDN (e.g. CloudFront) in front of the bucket. When set, newly
# uploaded images are served via this URL instead of the raw S3 endpoint.
# CDN_PUBLIC_URL=https://cdn.strix-blog.uk

ALLOW_REGISTRATION=true

# Set to "true" only when the server is behind a reverse proxy (nginx, Cloudflare, etc.)
# that strips and overwrites X-Forwarded-For / X-Real-IP before they reach this app.
# When false (default), the actual TCP socket IP is used for rate limiting instead,
# making it impossible for clients to spoof their IP.
TRUST_PROXY=false
