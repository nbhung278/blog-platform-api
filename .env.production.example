NODE_ENV=production
PORT=3000

POSTGRES_DB=blog_platform
POSTGRES_USER=blog_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_random_32_chars

JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_64
JWT_EXPIRES_IN=7d

APP_URL=https://strix-blog.uk
ADMIN_URL=https://admin.strix-blog.uk
COOKIE_DOMAIN=.strix-blog.uk

S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_BUCKET=strix-blog-media
S3_ACCESS_KEY=CHANGE_ME_aws_iam_access_key
S3_SECRET_KEY=CHANGE_ME_aws_iam_secret_key
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://strix-blog-media.s3.ap-southeast-1.amazonaws.com

ALLOW_REGISTRATION=true
TRUST_PROXY=true

# Optional. When set, /api/auth/setup requires the X-Setup-Token header to
# match this value. Lets you keep the bootstrap endpoint reachable for DR
# scenarios without leaving it open to whoever races the next signup if the
# DB ever ends up empty. Generate with: openssl rand -hex 32
# SETUP_TOKEN=CHANGE_ME_random_32_hex_chars
